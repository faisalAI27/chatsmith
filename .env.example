OPENAI_API_KEY=

SCRAPER_RENDER_MODE=auto
PLAYWRIGHT_TIMEOUT_MS=30000
PLAYWRIGHT_WAIT_MS=1000
PLAYWRIGHT_BLOCK_HEAVY_RESOURCES=true
PLAYWRIGHT_SCROLL_STEPS=4
PLAYWRIGHT_CONTENT_WAIT_MS=10000
PLAYWRIGHT_MAX_CONCURRENT_PAGES=2

# Crawler budget and behaviour
CRAWLER_MAX_PAGES=100
CRAWLER_MAX_DEPTH=5
CRAWLER_CONCURRENCY=4
CRAWLER_POLITENESS_DELAY_MS=250
CRAWLER_RESPECT_ROBOTS=true
CRAWLER_INCLUDE_SUBDOMAINS=false
CRAWLER_INCLUDE_DOCUMENTS=true
CRAWLER_MAX_DOCUMENTS=10
CRAWLER_SPECIFIC_PAGE_MAX_PAGES=5
CRAWLER_TIME_BUDGET_SECONDS=900
CRAWLER_ALLOW_PRIVATE_HOSTS=false
EXTRACTOR_TRAFILATURA_CHECK=true
KNOWLEDGE_EXPORT_ENABLED=true

# Web-search gap filling adds non-website content (outside the SDP scope); opt-in.
ENABLE_WEB_SEARCH_SUPPLEMENT=false

CORS_ALLOW_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

VECTOR_DB_PROVIDER=chroma
CHROMA_DB_DIR=backend/vector_store/chroma
CHROMA_COLLECTION_NAME=website_chunks

EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_BATCH_SIZE=64

RETRIEVAL_TOP_K=5
HYBRID_RETRIEVAL_ENABLED=true
HYBRID_LEXICAL_CANDIDATE_LIMIT=2000
HYBRID_VECTOR_CANDIDATE_MULTIPLIER=4
